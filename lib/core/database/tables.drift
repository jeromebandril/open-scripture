CREATE TABLE languages (
  id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
  langEngName NVARCHAR(64) NOT NULL,
  langNativeName NVARCHAR(64),
  langAbbreviation NVARCHAR(3)   -- uses ISO 639 language codes
)

CREATE TABLE bibles (
  id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
  languageId INT,
  bibleName NVARCHAR(64) NOT NULL,
  bibleNameAbbreviation NVARCHAR(32) NOT NULL,
);

CREATE TABLE books(
  id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
  bibleId INT NOT NULL,
  bookOrder INT,
  longName NVARCHAR(256),
  shortName NVARCHAR(64) NOT NULL,

  FOREIGN KEY (bibleId) REFERENCES bibles(id)
);

CREATE TABLE verses (
  id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
  bookId INT NOT NULL,
  paragraphId INT NOT NULL,
  chapterNumber INT NOT NULL,
  verseNumber SMALLINT NOT NULL,
  verseText NVARCHAR(1000) NOT NULL,
  
  FOREIGN KEY (paragraphId) REFERENCES paragraphs(id),
  FOREIGN KEY (bookId) REFERENCES books(id)
); 

CREATE TABLE paragraphs (
  id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
  bookId INT NOT NULL,
  subtitle NVARCHAR(128),
  chapterNumber INT NOT NULL,
  startVerse INT NOT NULl,
  endVerse INT NOT NULL,

  FOREIGN KEY (bookId) REFERENCES books(id)
);

CREATE TABLE verse_style (
  id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
  verseId INT NOT NULL,
  startIndex INT NOT NULL,
  endIndex INT NOT NULL,
  
  FOREIGN KEY (verseId) REFERENCES verses(id)
);

getVerses(:bibleId AS INT, :bookNumber AS INT, :chapterNumber AS INT, :verseStart AS INT OR NULL, :verseEnd AS INT OR NULL): 
SELECT v.chapterNumber, v.verseText, v.verseNumber FROM verses AS v
WHERE v.bookId = (SELECT id FROM books WHERE bookOrder = :bookNumber AND bibleId = :bibleId) 
  AND v.chapterNumber = :chapterNumber 
  AND (verseNumber >= :verseStart OR :verseStart IS NULL)  
  AND (verseNumber <= :verseEnd OR :verseEnd IS NULL);

getBibles: SELECT id, languageId, bibleName, bibleNameAbbreviation FROM bibles;
