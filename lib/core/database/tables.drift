CREATE TABLE languages (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  langEngName NVARCHAR(64) NOT NULL,
  langNativeName NVARCHAR(64),
  langIsoCode NVARCHAR(3)   -- uses ISO 639 language codes
);

CREATE TABLE bibles (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  extId NVARCHAR(80) NOT NULL UNIQUE,
  languageId INTEGER,
  bibleName NVARCHAR(64) NOT NULL,
  bibleNameAbbreviation NVARCHAR(32) NOT NULL,
  originSource NVARCHAR(128),

  FOREIGN KEY (languageId) REFERENCES languages(id) ON DELETE CASCADE
);

CREATE TABLE books(
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  bibleId INTEGER NOT NULL,
  osisId NVARCHAR(10) NOT NULL,
  bookOrder INT,
  longName NVARCHAR(256),
  shortName NVARCHAR(64) NOT NULL,

  FOREIGN KEY (bibleId) REFERENCES bibles(id) ON DELETE CASCADE,
  UNIQUE (bibleId, osisId)

);

CREATE TABLE verse_segments (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  bookId INTEGER NOT NULL,
  chapterNumber INT NOT NULL,
  verseNumber SMALLINT NOT NULL,
  segmentIndex INT NOT NULL,
  paragraphStart INT NOT NULL DEFAULT 0,
  textContent NVARCHAR(1000) NOT NULL,
  subtitle NVARCHAR(128),
  
  FOREIGN KEY (bookId) REFERENCES books(id) ON DELETE CASCADE,
  UNIQUE (bookId, chapterNumber, verseNumber, segmentIndex)
); 

CREATE TABLE segment_spans (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  segmentId INTEGER NOT NULL,
  startOffset INT NOT NULL,
  endOffset INT NOT NULL,
  spanType INTEGER NOT NULL,
  payload NVARCHAR(128),

  FOREIGN KEY (segmentId) REFERENCES verse_segments(id) ON DELETE CASCADE
);

CREATE INDEX ix_spans_segment ON segment_spans(segmentId, startOffset);
CREATE UNIQUE INDEX ux_languages_iso ON languages(langIsoCode);

getBibles: 
SELECT 
  b.id, b.extId, b.languageId, b.bibleName, b.bibleNameAbbreviation, b.originSource, 
  l.langEngName, l.langIsoCode, l.langNativeName
FROM bibles AS b
JOIN languages AS l on b.languageId = l.id;

getBible: 
SELECT 
  b.id, b.extId, b.languageId, b.bibleName, b.bibleNameAbbreviation, b.originSource, 
  l.langEngName, l.langIsoCode, l.langNativeName
FROM bibles AS b
JOIN languages AS l on b.languageId = l.id
WHERE b.id = :bibleId;

getVerseSegmentsForChapter:
SELECT *
FROM verse_segments AS s
JOIN books AS b ON b.id = s.bookId
WHERE b.bibleId = :bibleId
  AND b.osisId = :bookOsisId
  AND s.chapterNumber = :chapterNumber
ORDER BY s.verseNumber, s.segmentIndex;

getSegmentsForChapterWithSpans:
SELECT
  s.id AS segmentId,
  s.bookId,
  s.chapterNumber,
  s.verseNumber,
  s.segmentIndex,
  s.paragraphStart,
  s.textContent,
  s.subtitle,
  -- COALESCE(
  --   json_group_array(
  --     json_object(
  --       'segmentId', s.id,
  --       'id', sp.id,
  --       'startOffset', sp.startOffset,
  --       'endOffset', sp.endOffset,
  --       'spanType', sp.spanType,
  --       'payload', sp.payload
  --     )
  --   ),
  --   json('[]')
  -- ) AS spansJson
  COALESCE(
    (
      SELECT json_group_array(
        json_object(
          'segmentId', sp.segmentId,
          'id', sp.id,
          'startOffset', sp.startOffset,
          'endOffset', sp.endOffset,
          'spanType', sp.spanType,
          'payload', sp.payload
        )
      )
      FROM segment_spans sp
      WHERE sp.segmentId = s.id
      ORDER BY sp.startOffset
    ),
    json('[]')
  ) AS spansJson
FROM verse_segments AS s
LEFT JOIN segment_spans AS sp ON sp.segmentId = s.id
JOIN books AS b ON b.id = s.bookId
WHERE b.bibleId = :bibleId
  AND b.osisId = :bookOsisId
  AND s.chapterNumber = :chapterNumber
GROUP BY s.id
ORDER BY s.verseNumber, s.segmentIndex, sp.startOffset;

getSegmentsByBibleId: 
SELECT vs.id, bookId, b.osisId as bookOsisId, chapterNumber, verseNumber, segmentIndex
FROM verse_segments AS vs
JOIN books AS b ON b.id = vs.bookId
WHERE b.bibleId = :bibleId;


