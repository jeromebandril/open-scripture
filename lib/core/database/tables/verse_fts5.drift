-- queries


clearVerseText:
DELETE FROM verse_text WHERE bibleId = :bibleId;


populateVerseText:
INSERT INTO verse_text(bibleId, bookOsisId, bookId, chapterNumber, verseNumber, textContent)
SELECT
  b.bibleId,
  b.osisId,
  v.bookId,
  v.chapterNumber,
  v.verseNumber,
  (
    SELECT GROUP_CONCAT(vs2.textContent, ' ')
    FROM verse_segments vs2
    WHERE vs2.bookId = v.bookId
      AND vs2.chapterNumber = v.chapterNumber
      AND vs2.verseNumber = v.verseNumber
    ORDER BY vs2.segmentIndex
  ) AS textContent
FROM (
  SELECT DISTINCT bookId, chapterNumber, verseNumber
  FROM verse_segments
) v
JOIN books b ON b.id = v.bookId
WHERE b.bibleId = :bibleId;



searchVerses:
WITH hits AS (
  SELECT rowid, bm25(verse_text_fts) AS rank
  FROM verse_text_fts
  WHERE CAST(bibleId AS INTEGER) = :bibleId
    AND verse_text_fts MATCH :query
  ORDER BY rank
  LIMIT :limit
)
SELECT vt.bibleId, vt.bookOsisId, vt.chapterNumber, vt.verseNumber
FROM hits
JOIN verse_text vt ON vt.id = hits.rowid
ORDER BY hits.rank;


testQuery:
SELECT rowid
FROM verse_text_fts
WHERE verse_text_fts MATCH :q
LIMIT 100;