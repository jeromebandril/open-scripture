import './core_tables.drift';

CREATE TABLE verse_text (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  bibleId INTEGER NOT NULL,
  bookOsisId NVARCHAR(10) NOT NULL,
  bookId INTEGER NOT NULL,
  chapterNumber INT NOT NULL,
  verseNumber SMALLINT NOT NULL,
  textContent TEXT NOT NULL,

  FOREIGN KEY (bookId) REFERENCES books(id) ON DELETE CASCADE,
  UNIQUE (bibleId, bookOsisId, chapterNumber, verseNumber)
);

CREATE INDEX ix_verse_text_bible
  ON verse_text(bibleId, bookOsisId, chapterNumber, verseNumber);

CREATE VIRTUAL TABLE verse_text_fts
USING fts5(
  textContent,
  bibleId UNINDEXED,
  content='verse_text',
  content_rowid='id'
);

-- triggers

CREATE TRIGGER verse_text_ai AFTER INSERT ON verse_text BEGIN
  INSERT INTO verse_text_fts(rowid, textContent, bibleId)
  VALUES (new.id, new.textContent, new.bibleId);
END;

