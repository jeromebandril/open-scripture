import '../tables/core_tables.drift';

getBibles: 
SELECT 
  b.id, b.usfxId, b.languageId, b.bibleName, b.bibleNameLocal, b.bibleNameAbbreviation, b.originSource, 
  l.langEngName, l.langIsoCode, l.langNativeName
FROM bibles AS b
JOIN languages AS l on b.languageId = l.id;

getBible: 
SELECT 
  b.id, b.usfxId, b.languageId, b.bibleName, b.bibleNameLocal, b.bibleNameAbbreviation, b.originSource, 
  l.langEngName, l.langIsoCode, l.langNativeName
FROM bibles AS b
JOIN languages AS l on b.languageId = l.id
WHERE b.id = :bibleId;

getVerseSegmentsForChapter:
SELECT *
FROM verse_segments AS s
JOIN books AS b ON b.id = s.bookId
WHERE b.bibleId = :bibleId
  AND b.usfxId = :bookusfxId
  AND s.chapterNumber = :chapterNumber
ORDER BY s.verseNumber, s.segmentIndex;

getSegmentsForChapterWithSpans:
SELECT
  s.id AS segmentId,
  s.bookId,
  s.chapterNumber,
  s.verseNumber,
  s.segmentIndex,
  s.paragraphStart,
  s.textContent,
  s.subtitle,
  -- COALESCE(
  --   json_group_array(
  --     json_object(
  --       'segmentId', s.id,
  --       'id', sp.id,
  --       'startOffset', sp.startOffset,
  --       'endOffset', sp.endOffset,
  --       'spanType', sp.spanType,
  --       'payload', sp.payload
  --     )
  --   ),
  --   json('[]')
  -- ) AS spansJson
  COALESCE(
    (
      SELECT json_group_array(
        json_object(
          'segmentId', sp.segmentId,
          'id', sp.id,
          'startOffset', sp.startOffset,
          'endOffset', sp.endOffset,
          'spanType', sp.spanType,
          'payload', sp.payload
        )
      )
      FROM segment_spans sp
      WHERE sp.segmentId = s.id
      ORDER BY sp.startOffset
    ),
    json('[]')
  ) AS spansJson
FROM verse_segments AS s
LEFT JOIN segment_spans AS sp ON sp.segmentId = s.id
JOIN books AS b ON b.id = s.bookId
WHERE b.bibleId = :bibleId
  AND b.usfxId = :bookusfxId
  AND s.chapterNumber = :chapterNumber
GROUP BY s.id
ORDER BY s.verseNumber, s.segmentIndex, sp.startOffset;

getSegmentsByBibleId: 
SELECT vs.id, bookId, b.usfxId as bookUsfxId, chapterNumber, verseNumber, segmentIndex
FROM verse_segments AS vs
JOIN books AS b ON b.id = vs.bookId
WHERE b.bibleId = :bibleId;

getBooks:
SELECT * FROM books WHERE bibleId = :bibleId ORDER BY id;

getMaxChapter:
SELECT MAX(chapterNumber) AS chapter_count 
FROM verse_segments 
WHERE bookId = :bookId;

getMaxVerse:
SELECT MAX(verseNumber) 
FROM verse_segments 
WHERE bookId = :bookId AND chapterNumber = :chapter;
